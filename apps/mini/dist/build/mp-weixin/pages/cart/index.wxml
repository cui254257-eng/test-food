<view class="cart-page min-h-screen px-4 pb-8 pt-5 data-v-bffd35d3"><view class="page-heading data-v-bffd35d3"><view class="data-v-bffd35d3"><text class="heading-kicker data-v-bffd35d3">YOUR SELECTION</text><text class="page-title data-v-bffd35d3">购物车</text><text class="page-subtitle data-v-bffd35d3">已选好的美味都在这里</text></view><view class="heading-icon data-v-bffd35d3">🛍</view></view><view wx:if="{{a}}" class="cart-list data-v-bffd35d3"><view class="list-caption data-v-bffd35d3"><text class="data-v-bffd35d3">商品清单</text><text class="data-v-bffd35d3">共 {{b}} 份</text></view><view wx:for="{{c}}" wx:for-item="line" wx:key="m" class="cart-item data-v-bffd35d3"><image wx:if="{{line.a}}" class="item-image data-v-bffd35d3" src="{{line.b}}" mode="aspectFill"/><view wx:else class="item-placeholder data-v-bffd35d3">{{line.c}}</view><view class="item-info data-v-bffd35d3"><text class="item-name data-v-bffd35d3">{{line.d}}</text><text wx:if="{{line.e}}" class="item-selections data-v-bffd35d3">{{line.f}}</text><text class="item-price data-v-bffd35d3">¥{{line.g}}</text></view><view class="quantity-control data-v-bffd35d3"><text class="quantity-button data-v-bffd35d3" bindtap="{{line.h}}">−</text><text class="quantity-value data-v-bffd35d3">{{line.i}}</text><text class="{{['quantity-button', 'plus', 'data-v-bffd35d3', line.j && 'disabled']}}" bindtap="{{line.k}}">＋</text></view><text class="remove-action data-v-bffd35d3" bindtap="{{line.l}}">移除</text></view></view><view wx:else class="empty-card data-v-bffd35d3"><text class="empty-icon data-v-bffd35d3">🥣</text><text class="empty-title data-v-bffd35d3">购物车还是空的</text><text class="empty-copy data-v-bffd35d3">去今日菜单挑几道喜欢的菜吧</text><view class="menu-button data-v-bffd35d3" bindtap="{{d}}">去今日菜单</view></view><view wx:if="{{e}}" class="cart-summary data-v-bffd35d3"><view class="summary-row data-v-bffd35d3"><text class="data-v-bffd35d3">商品数量</text><text class="data-v-bffd35d3">{{f}} 份</text></view><view class="summary-row data-v-bffd35d3"><text class="data-v-bffd35d3">商品金额</text><text class="summary-price data-v-bffd35d3">¥{{g}}</text></view><text class="summary-note data-v-bffd35d3">配送方式和配送费将在结账页确认</text><view class="checkout-button data-v-bffd35d3" bindtap="{{i}}">去结账 <text class="data-v-bffd35d3">¥{{h}}</text></view></view></view>