.wd-notice-bar {
  display: flex;
  padding: var(--wot-notice-bar-padding, var(--wot-padding-main, var(--wot-n-10, 10px)) var(--wot-padding-loose, var(--wot-n-12, 12px)));
  align-items: center;
  font-size: var(--wot-notice-bar-font-size, var(--wot-typography-body-size-main, var(--wot-n-14, 14px)));
  border-radius: var(--wot-notice-bar-radius, var(--wot-radius-zero, var(--wot-n-0, 0px)));
  position: relative;
  box-sizing: border-box;
}
.wd-notice-bar.is-warning {
  background: var(--wot-notice-bar-warning-bg, var(--wot-warning-surface, var(--wot-orange-1, #fff6eb)));
  color: var(--wot-notice-bar-warning-color, var(--wot-warning-main, var(--wot-orange-6, #f57f00)));
}
.wd-notice-bar.is-info {
  background: var(--wot-notice-bar-info-bg, var(--wot-primary-1, var(--wot-blue-1, #f5f8ff)));
  color: var(--wot-notice-bar-info-color, var(--wot-primary-6, var(--wot-blue-6, #1c64fd)));
}
.wd-notice-bar.is-danger {
  background: var(--wot-notice-bar-danger-bg, var(--wot-danger-surface, var(--wot-red-1, #fff5f5)));
  color: var(--wot-notice-bar-danger-color, var(--wot-danger-main, var(--wot-red-6, #f14646)));
}
.wd-notice-bar  .wd-notice-bar__prefix {
  margin-right: var(--wot-notice-bar-prefix-margin-right, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
  font-size: var(--wot-notice-bar-prefix-size, var(--wot-n-20, 20px));
  line-height: var(--wot-notice-bar-prefix-size, var(--wot-n-20, 20px));
}
.wd-notice-bar  .wd-notice-bar__suffix {
  font-size: var(--wot-notice-bar-suffix-size, var(--wot-n-20, 20px));
  line-height: var(--wot-notice-bar-suffix-size, var(--wot-n-20, 20px));
  color: var(--wot-notice-bar-suffix-color, inherit);
  margin-left: var(--wot-notice-bar-suffix-margin-left, var(--wot-spacing-tight, var(--wot-n-8, 8px)));
}
.wd-notice-bar__wrap {
  position: relative;
  flex: 1;
  height: var(--wot-notice-bar-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
  overflow: hidden;
  line-height: var(--wot-notice-bar-line-height, var(--wot-typography-body-line-height-size-main, var(--wot-n-20, 20px)));
}
.wd-notice-bar__content {
  position: absolute;
  white-space: nowrap;
}
.wd-notice-bar--ellipse .wd-notice-bar__content {
  position: static;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wd-notice-bar--wrap .wd-notice-bar__wrap {
  height: auto;
}
.wd-notice-bar--wrap .wd-notice-bar__content {
  position: static;
  white-space: normal;
}