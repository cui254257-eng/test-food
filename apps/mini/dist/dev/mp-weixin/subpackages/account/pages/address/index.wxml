<view class="address-page min-h-screen px-4 pb-10 pt-4 data-v-5baa93b3"><view wx:if="{{a}}" class="selection-heading data-v-5baa93b3">选择外卖地址</view><view class="privacy-note data-v-5baa93b3"><text class="privacy-icon data-v-5baa93b3">🔒</text><text class="data-v-5baa93b3">地址仅用于配送，并与当前微信账号绑定</text></view><view wx:if="{{b}}" class="state-card data-v-5baa93b3">正在加载收货地址…</view><view wx:elif="{{c}}" class="state-card data-v-5baa93b3"><text class="state-title data-v-5baa93b3">暂时无法加载</text><text class="state-copy data-v-5baa93b3">{{d}}</text><view class="retry-button data-v-5baa93b3" bindtap="{{e}}">重新加载</view></view><view wx:elif="{{f}}" class="empty-card data-v-5baa93b3"><view class="empty-mark data-v-5baa93b3">⌖</view><text class="empty-title data-v-5baa93b3">还没有收货地址</text><text class="empty-copy data-v-5baa93b3">添加外卖配送地址</text></view><view wx:else class="address-list data-v-5baa93b3"><view wx:for="{{g}}" wx:for-item="address" wx:key="l" class="address-card data-v-5baa93b3"><view class="address-main data-v-5baa93b3" bindtap="{{address.i}}"><view class="recipient-line data-v-5baa93b3"><text class="recipient-name data-v-5baa93b3">{{address.a}}</text><text class="recipient-phone data-v-5baa93b3">{{address.b}}</text><text wx:if="{{address.c}}" class="default-tag data-v-5baa93b3">默认</text><text wx:if="{{address.d}}" class="selected-tag data-v-5baa93b3">已选</text></view><text class="address-detail data-v-5baa93b3">{{address.e}}{{address.f}}{{address.g}}{{address.h}}</text></view><view class="address-actions data-v-5baa93b3"><text class="edit-action data-v-5baa93b3" bindtap="{{address.j}}">编辑</text><text class="action-separator data-v-5baa93b3">·</text><text class="delete-action data-v-5baa93b3" bindtap="{{address.k}}">删除</text></view></view></view><view class="add-button data-v-5baa93b3" bindtap="{{h}}"><text class="add-symbol data-v-5baa93b3">＋</text><text class="data-v-5baa93b3">新增收货地址</text></view><text wx:if="{{i}}" class="inline-error data-v-5baa93b3">{{j}}</text></view>