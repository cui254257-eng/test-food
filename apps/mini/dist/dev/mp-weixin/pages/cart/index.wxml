<view class="cart-page min-h-screen px-4 pb-8 pt-5 data-v-3277fd7b"><view class="page-heading data-v-3277fd7b"><view class="data-v-3277fd7b"><text class="heading-kicker data-v-3277fd7b">YOUR SELECTION</text><text class="page-title data-v-3277fd7b">购物车</text><text class="page-subtitle data-v-3277fd7b">已选好的美味都在这里</text></view><view class="heading-icon data-v-3277fd7b">🛍</view></view><view wx:if="{{a}}" class="cart-list data-v-3277fd7b"><view class="list-caption data-v-3277fd7b"><text class="data-v-3277fd7b">商品清单</text><text class="data-v-3277fd7b">共 {{b}} 份</text></view><view wx:for="{{c}}" wx:for-item="line" wx:key="m" class="cart-item data-v-3277fd7b"><image wx:if="{{line.a}}" class="item-image data-v-3277fd7b" src="{{line.b}}" mode="aspectFill"/><view wx:else class="item-placeholder data-v-3277fd7b">{{line.c}}</view><view class="item-info data-v-3277fd7b"><text class="item-name data-v-3277fd7b">{{line.d}}</text><text wx:if="{{line.e}}" class="item-selections data-v-3277fd7b">{{line.f}}</text><text class="item-price data-v-3277fd7b">¥{{line.g}}</text></view><view class="quantity-control data-v-3277fd7b"><text class="quantity-button data-v-3277fd7b" bindtap="{{line.h}}">−</text><text class="quantity-value data-v-3277fd7b">{{line.i}}</text><text class="{{['quantity-button', 'plus', 'data-v-3277fd7b', line.j && 'disabled']}}" bindtap="{{line.k}}">＋</text></view><text class="remove-action data-v-3277fd7b" bindtap="{{line.l}}">移除</text></view></view><view wx:else class="empty-card data-v-3277fd7b"><text class="empty-icon data-v-3277fd7b">🥣</text><text class="empty-title data-v-3277fd7b">购物车还是空的</text><text class="empty-copy data-v-3277fd7b">去今日菜单挑几道喜欢的菜吧</text><view class="menu-button data-v-3277fd7b" bindtap="{{d}}">去今日菜单</view></view><view wx:if="{{e}}" class="cart-summary data-v-3277fd7b"><view class="summary-row data-v-3277fd7b"><text class="data-v-3277fd7b">商品数量</text><text class="data-v-3277fd7b">{{f}} 份</text></view><view class="summary-row data-v-3277fd7b"><text class="data-v-3277fd7b">商品金额</text><text class="summary-price data-v-3277fd7b">¥{{g}}</text></view><text class="summary-note data-v-3277fd7b">配送方式和配送费将在结账页确认</text><view class="checkout-button data-v-3277fd7b" bindtap="{{i}}">去结账 <text class="data-v-3277fd7b">¥{{h}}</text></view></view></view>